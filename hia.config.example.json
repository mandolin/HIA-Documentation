{
  "schemaVersion": "0.1.0",
  "docs": {
    "input": "fixtures/basic.hia.json",
    "output": "dist/docs-config",
    "locale": "en",
    "manifest": "hia-manifest.json",
    "renderer": {
      "title": "HIA Config Example",
      "includeThemeAssets": true,
      "projectLayout": "split-site"
    },
    "theme": {
      "name": "default",
      "skin": "portal.classic",
      "scheme": "system"
    },
    "source": {
      "enabled": true,
      "mode": "file",
      "presentation": "fetch",
      "publicAssetPolicy": "explicit-public",
      "localRoot": ".",
      "fetchTrigger": "on-expand",
      "openMode": "same-tab"
    }
  }
}
