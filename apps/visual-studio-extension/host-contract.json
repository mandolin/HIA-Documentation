{
  "contract": "hia-visual-studio-host-skeleton",
  "contractVersion": "0.1.0-draft",
  "status": "install-runtime-captured",
  "appDirectory": "apps/visual-studio-extension",
  "host": {
    "displayName": "HIA Documentation Visual Studio",
    "kind": "visual-studio-extension",
    "model": "hybrid",
    "primaryRoute": "VisualStudio.Extensibility command and tool-window shell with a Visual Studio LSP client",
    "targetIde": "Visual Studio"
  },
  "runtime": {
    "preparationStatus": "install-runtime-captured",
    "actualVisualStudioRuntimeCaptureExecuted": true,
    "visualStudioExtensionPackageBuilt": true,
    "experimentalInstanceExecuted": true,
    "dependencyLicenseAuditRequiredBeforeVsix": true,
    "dependencyLicenseAuditCompleted": true,
    "userLicenseAcceptanceRecorded": true,
    "projectFile": "apps/visual-studio-extension/HiaDocumentation.VisualStudio.csproj",
    "toolWindowImplemented": true,
    "localizedReviewToolWindowImplemented": true,
    "reviewSurfaceContractEmbedded": true,
    "remoteUiLocalizationCultures": [
      "en-US",
      "zh-Hans"
    ],
    "metadataLocalizationCultures": [
      "zh-CN",
      "zh-Hans"
    ],
    "languageServerProviderImplemented": true,
    "authoringProjectionImplemented": true,
    "authoringProjectionSession": "isolated-read-only-lsp-session",
    "authoringProjectionFixture": "synthetic-public-fixture",
    "authoringProjectionRequestCount": 3,
    "languageServer": {
      "package": "@hia-doc/lsp",
      "packageVersion": "0.1.0",
      "transport": "stdio",
      "vsixRelativePath": "runtime/lsp/dist/node.js",
      "nodeEngine": ">=20.19.0",
      "activationFileExtensions": [
        ".hia.json",
        ".docmap.json"
      ],
      "runtimeDeployment": "pnpm-legacy-hoisted-production-deploy",
      "selfContainedAfterVsixExtraction": true,
      "symbolicLinkCount": 0,
      "publicDiagnosticPolicy": "stable-reason-codes-only"
    },
    "cli": {
      "package": "@hia-doc/cli",
      "workspaceRelativePath": "apps/cli/dist/index.js"
    },
    "runtimeCapture": {
      "contract": "hia-visual-studio-runtime-capture@0.1.0-draft",
      "status": "captured",
      "deploymentModel": "visualstudio-extensibility-f5-oop-experimental-instance",
      "capturedHostCount": 2,
      "validatedIdeMajors": [
        17,
        18
      ],
      "languageServerReadyHostCount": 2,
      "liveAuthoringReadyHostCount": 2,
      "screenshotCount": 6,
      "ordinaryInstanceInstallClaimed": false,
      "hostEditorApiCalled": false,
      "workspaceWriteAllowed": false,
      "targetRepositoryMutationAllowed": false
    }
  },
  "surfaces": [
    {
      "id": "hia-vs-lsp-client",
      "kind": "language-server-client",
      "owns": [
        "Visual Studio language-client registration",
        "standard LSP diagnostics, completion, hover, definition and folding presentation"
      ],
      "consumes": [
        "initialize",
        "textDocument/publishDiagnostics",
        "textDocument/completion",
        "textDocument/hover",
        "textDocument/definition",
        "textDocument/foldingRange"
      ]
    },
    {
      "id": "hia-vs-relation-tool-window",
      "kind": "tool-window",
      "owns": [
        "relation graph tree and detail presentation",
        "source-linkage result presentation",
        "host fallback and empty-state messages"
      ],
      "consumes": [
        "hia/ideCapabilities",
        "hia/documentAuthoringLocations",
        "hia/documentSourceMapIndex",
        "hia/projectRelationGraph",
        "hia/resourceActions",
        "hia/documentationEditProposals"
      ]
    },
    {
      "id": "hia-vs-review-tool-window",
      "kind": "tool-window",
      "owns": [
        "documentation proposal list and detail presentation",
        "draft text copy action",
        "read-only edit candidate preview",
        "provider origin, review metadata and refusal presentation",
        "locale-quality and language-marker review hints"
      ],
      "consumes": [
        "hia/documentationEditProposals",
        "hia-documentation-review-payload@0.1.0-draft",
        "hia-documentation-edit-candidate@0.1.0-draft",
        "hia-provider-review-payload-augmentation@0.1.0-draft",
        "hia-lsp-host-result@0.1.0-draft"
      ],
      "applySupport": "disabled-until-human-approved-workspace-edit-contract"
    },
    {
      "id": "hia-vs-commands",
      "kind": "command",
      "owns": [
        "build docs command",
        "open preview command",
        "validate workspace command",
        "open source or generated artifact command"
      ],
      "delegatesTo": [
        "@hia-doc/cli",
        "@hia-doc/lsp",
        "Visual Studio shell APIs"
      ]
    }
  ],
  "customRequests": [
    {
      "method": "hia/ideCapabilities",
      "purpose": "Read host capability availability before showing commands or tool-window states."
    },
    {
      "method": "hia/documentAuthoringLocations",
      "purpose": "Read public-safe authoring locations from an isolated synthetic document without calling host editor APIs."
    },
    {
      "capability": "hia.sourceLinkage.query",
      "method": "hia/documentSourceMapIndex",
      "requiresHostMetadata": true,
      "version": "0.1.0-draft"
    },
    {
      "capability": "hia.projectRelationGraph.query",
      "method": "hia/projectRelationGraph",
      "requiresHostMetadata": true,
      "version": "0.1.0-draft"
    },
    {
      "method": "hia/resourceActions",
      "purpose": "Read open/copy/preflight actions without letting the Visual Studio host write project files directly."
    },
    {
      "capability": "hia.documentationEditProposal",
      "method": "hia/documentationEditProposals",
      "purpose": "Read public-safe reviewable documentation edit proposals for human review workflows.",
      "requiresHostMetadata": true,
      "version": "0.1.0-draft"
    }
  ],
  "hostResultMetadata": {
    "contract": "hia-lsp-host-result",
    "contractVersion": "0.1.0-draft",
    "requiredFields": [
      "contract",
      "contractVersion",
      "request.method",
      "request.version",
      "capability",
      "source"
    ],
    "supportedEmptyStates": [
      "not-loaded",
      "query-no-match",
      "relation-graph-empty",
      "source-data-empty"
    ],
    "supportedSources": [
      "managed-document",
      "workspace-runtime",
      "none"
    ]
  },
  "structuredOpenRequests": [
    {
      "type": "hia.openSource",
      "visualStudioAction": "Open a workspace-relative source file and optional position."
    },
    {
      "type": "hia.openGenerated",
      "visualStudioAction": "Open a generated artifact inside the workspace."
    },
    {
      "type": "hia.openDocumentationEntry",
      "visualStudioAction": "Open generated documentation or focus the matching entry when the host view supports it."
    }
  ],
  "targetScenarios": [
    {
      "id": "hia-aspnetportal",
      "purpose": "ASP.NET/C# endpoint and component documentation navigation",
      "targetRepositoryPolicy": "read-only-central-notify-pull"
    }
  ],
  "privacy": {
    "allowAbsolutePathsInHostPayload": false,
    "allowTargetRepositoryMutation": false,
    "embedsSourcesContent": false,
    "allowsAutomaticApply": false,
    "requiresHumanReviewForEditProposals": true,
    "parsesGeneratedHtml": false,
    "runsDocumentationProducers": false
  },
  "authoringProjection": {
    "mode": "isolated-read-only-lsp-session",
    "requests": [
      "hia/ideCapabilities",
      "hia/documentAuthoringLocations",
      "hia/documentationEditProposals"
    ],
    "syntheticFixtureOnly": true,
    "sharesVisualStudioManagedLspStream": false,
    "includesSourceContent": false,
    "allowsAutomaticWrites": false,
    "hostEditorApiCalled": false,
    "workspaceWriteAllowed": false,
    "targetRepositoryMutationAllowed": false,
    "providerNetworkExecuted": false
  }
}
