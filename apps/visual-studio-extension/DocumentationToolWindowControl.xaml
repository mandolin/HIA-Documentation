<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:colors="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0">
  <DataTemplate.Resources>
    <DataTemplate x:Key="MetricTemplate">
      <Grid Margin="0,4,0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Label}"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap" />
        <TextBlock Grid.Column="1"
                   Margin="16,0,0,0"
                   Text="{Binding Value}"
                   TextWrapping="Wrap" />
      </Grid>
    </DataTemplate>
  </DataTemplate.Resources>

  <Border Background="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
          TextElement.Foreground="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowTextBrushKey}}"
          Padding="16">
    <Grid MinWidth="460">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Text="{Binding ProductName}"
                 FontSize="20"
                 FontWeight="SemiBold" />
      <StackPanel Grid.Row="1"
                  Margin="0,6,0,12"
                  Orientation="Horizontal">
        <TextBlock Text="{Binding Phase}"
                   FontWeight="SemiBold" />
        <TextBlock Margin="16,0,0,0"
                   Text="{Binding Locale}" />
      </StackPanel>

      <TabControl Grid.Row="2">
        <TabItem Header="{Binding OverviewTab}">
          <ScrollViewer Padding="12"
                        VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding OverviewMetrics}"
                          ItemTemplate="{StaticResource MetricTemplate}" />
          </ScrollViewer>
        </TabItem>
        <TabItem Header="{Binding AuthoringTab}">
          <ScrollViewer Padding="12"
                        VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding AuthoringMetrics}"
                          ItemTemplate="{StaticResource MetricTemplate}" />
          </ScrollViewer>
        </TabItem>
        <TabItem Header="{Binding ReviewTab}">
          <ScrollViewer Padding="12"
                        VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding ReviewMetrics}"
                          ItemTemplate="{StaticResource MetricTemplate}" />
          </ScrollViewer>
        </TabItem>
        <TabItem Header="{Binding SafetyTab}">
          <ScrollViewer Padding="12"
                        VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding SafetyMetrics}"
                          ItemTemplate="{StaticResource MetricTemplate}" />
          </ScrollViewer>
        </TabItem>
        <TabItem Header="{Binding LanguageServerTab}">
          <ScrollViewer Padding="12"
                        VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding LanguageServerMetrics}"
                          ItemTemplate="{StaticResource MetricTemplate}" />
          </ScrollViewer>
        </TabItem>
        <TabItem Header="{Binding ProjectionTab}">
          <ScrollViewer Padding="12"
                        VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding ProjectionMetrics}"
                          ItemTemplate="{StaticResource MetricTemplate}" />
          </ScrollViewer>
        </TabItem>
      </TabControl>

      <TextBlock Grid.Row="3"
                 Margin="0,12,0,0"
                 Text="{Binding Boundary}"
                 FontWeight="SemiBold"
                 TextWrapping="Wrap" />
    </Grid>
  </Border>
</DataTemplate>
