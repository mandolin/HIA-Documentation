---
/**
 * @lang zh-CN 从显式清单生成静态中英页面，不从磁盘目录推断发布或语言覆盖。
 * @lang en Generate static bilingual pages from an explicit inventory, without inferring release or translation coverage from directories.
 */
import SiteShell from "../layouts/SiteShell.astro";
import Home from "../components/Home.astro";
import Features from "../components/Features.astro";
import Docs from "../components/Docs.astro";
import DocCards from "../components/DocCards.astro";
import Article from "../components/Article.astro";
import Versions from "../components/Versions.astro";
import { manual } from "../lib/content.mjs";
import { locales, kinds, manualKinds, route, href, labels } from "../lib/routes.mjs";
import { currentDocumentation } from "../lib/version-index.mjs";
/**
 * @lang zh-CN 为已有双语正文及中文默认文档入口枚举路径；根页面使用undefined参数。
 * @lang en Enumerate existing bilingual content and the Chinese default documentation entry; the root page uses an undefined parameter.
 * @returns {Array} Astro静态路径与页面参数。 Static Astro paths and props.
 */
export function getStaticPaths() {
  // <lang><zh-CN>显式语言主题沿原清单生成，默认文档入口复用中文页面属性。</zh-CN><en>Generate explicit-language topics from the existing inventory and reuse Chinese page props for the default documentation entry.</en></lang>
  const contentPaths = locales.flatMap(locale => kinds.map(kind => ({
    params: { path: route(kind, locale).replace(/\/$/, "") || undefined },
    props: { locale, kind },
  })));
  return [...contentPaths, {
    params: {path: "docs"},
    props: {locale: "zh-CN", kind: "docs"},
  }];
}
// <lang lang="zh-CN">构建属性来自上方固定清单，不接受请求参数或远程内容。</lang><lang lang="en">Build props come from the fixed inventory, never request parameters or remote content.</lang>
const { locale, kind } = Astro.props;
const en = locale === "en";
const text = (zh: string, english: string) => en ? english : zh;
// <lang lang="zh-CN">正文与真实标题来自同一已登记模块。</lang><lang lang="en">Content and actual headings come from the same registered module.</lang>
const document = manualKinds.includes(kind) ? manual(kind, locale) : undefined;
const Content = document?.Content;
---
<SiteShell locale={locale} kind={kind}>
  {kind === "home" && <Home locale={locale}><DocCards locale={locale} /></Home>}
  {kind === "features" && <Features locale={locale} />}
  {kind === "docs" && <Docs locale={locale} />}
  {[...manualKinds, "versions", "search"].includes(kind) && <Article locale={locale} kind={kind} headings={document?.getHeadings()}>
    {Content && <Content />}
    {kind === "versions" && <Versions locale={locale} />}
    {kind === "search" && <><p class="eyebrow">Documentation search</p><h1>{labels[locale].search}</h1><p class="lede">{currentDocumentation.version} · {text("预览 · 简体中文", "preview · English")}</p><p>{text("本地检索当前语言的九篇手册标题和正文。多个词须全部命中，最多显示20项；尚未索引生成API与外链技术深页。", "Search nine current-language manual titles and bodies locally. All query terms must match; at most 20 results are shown. Generated APIs and linked technical references are not indexed yet.")}</p><div class="js-only search-form"><label for="page-query">{text("搜索手册正文", "Search manual content")}</label><input class="search-input" id="page-query" type="search" maxlength="500" data-search-input="page-results" /></div><div id="page-results" class="results" aria-live="polite"></div><noscript><div class="notice"><strong>{text("脚本未启用", "Scripts are disabled")}</strong><p>{text("请从下方静态目录继续阅读。", "Continue through the static directory below.")}</p></div></noscript><h2 id="directory">{text("静态目录", "Static directory")}</h2><nav class="results" aria-label={text("当前语言目录", "Current language directory")}>{kinds.filter(topic => topic !== "search").map(topic => <a href={href(topic, locale, import.meta.env.BASE_URL)}>{labels[locale][topic as keyof typeof labels.en]}</a>)}</nav></>}
  </Article>}
</SiteShell>
