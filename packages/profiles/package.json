{
  "name": "@hia-doc/profiles",
  "version": "1.0.0",
  "description": "Official documentation profile distribution for HIA documentation tools.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mandolin/HIA-Documentation.git",
    "directory": "packages/profiles"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./catalog.json": "./dist/catalog.json",
    "./cssdoc.profile.json": "./dist/profiles/cssdoc.profile.json",
    "./doc-source-map.profile.json": "./dist/profiles/doc-source-map.profile.json",
    "./htmdoc.profile.json": "./dist/profiles/htmdoc.profile.json",
    "./jsdoc.profile.json": "./dist/profiles/jsdoc.profile.json",
    "./pug-htmdoc-bridge.profile.json": "./dist/profiles/pug-htmdoc-bridge.profile.json",
    "./sass-cssdoc-bridge.profile.json": "./dist/profiles/sass-cssdoc-bridge.profile.json",
    "./ts-jsdoc-bridge.profile.json": "./dist/profiles/ts-jsdoc-bridge.profile.json",
    "./ts-jsdoc-bridge/0.2.0-draft.profile.json": "./dist/profiles/versioned/ts-jsdoc-bridge-0.2.0-draft.profile.json",
    "./ts-jsdoc-bridge/0.3.0-draft.profile.json": "./dist/profiles/versioned/ts-jsdoc-bridge-0.3.0-draft.profile.json",
    "./ts-jsdoc-bridge/0.4.0-draft.profile.json": "./dist/profiles/versioned/ts-jsdoc-bridge-0.4.0-draft.profile.json",
    "./tsdoc-project/catalog.json": "./dist/tsdoc-project-catalog.json",
    "./tsdoc-project/0.3.0-draft/catalog.json": "./dist/tsdoc-structured-project-catalog.json",
    "./tsdoc-project/0.4.0-draft/catalog.json": "./dist/tsdoc-wrapped-project-catalog.json",
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --root ../.. packages/profiles/src"
  },
  "dependencies": {
    "@hia-doc/profile": "workspace:*"
  },
  "sideEffects": false
}
