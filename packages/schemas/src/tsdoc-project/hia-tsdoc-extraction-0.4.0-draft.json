{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mandolin.github.io/HIA-Documentation/schemas/hia-tsdoc-extraction-0.4.0-draft.json",
  "type": "object",
  "required": [
    "contract",
    "contractVersion",
    "producer",
    "profile",
    "source",
    "artifacts",
    "modules",
    "symbols",
    "comments",
    "diagnostics",
    "metadata"
  ],
  "properties": {
    "contract": {
      "const": "hia-tsdoc-extraction"
    },
    "contractVersion": {
      "const": "0.4.0-draft"
    },
    "producer": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonempty"
        },
        "version": {
          "$ref": "#/$defs/nonempty"
        }
      }
    },
    "profile": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "const": "ts-jsdoc-bridge"
        },
        "version": {
          "const": "0.4.0-draft"
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "path",
        "language",
        "sourcesContentPolicy"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "language": {
          "const": "typescript"
        },
        "sourcesContentPolicy": {
          "const": "none"
        }
      }
    },
    "artifacts": {
      "type": "array"
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/module"
      }
    },
    "symbols": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "$ref": "#/$defs/symbol"
      }
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "symbolId",
          "range"
        ],
        "properties": {
          "symbolId": {
            "$ref": "#/$defs/nonempty"
          },
          "range": {
            "$ref": "#/$defs/range"
          }
        }
      }
    },
    "diagnostics": {
      "type": "array"
    },
    "metadata": {
      "type": "object",
      "required": [
        "typeExpressions"
      ],
      "properties": {
        "typeExpressions": {
          "const": "0.4.0-draft"
        }
      }
    }
  },
  "$defs": {
    "nonempty": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*[\\\\:%?#\\u0000-\\u001f\\u007f])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\/$).+$"
    },
    "position": {
      "type": "object",
      "required": [
        "line",
        "column"
      ],
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "column": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "range": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/position"
        },
        "end": {
          "$ref": "#/$defs/position"
        }
      }
    },
    "convention": {
      "type": "object",
      "required": [
        "endBoundary",
        "columnUnit"
      ],
      "properties": {
        "endBoundary": {
          "const": "exclusive"
        },
        "columnUnit": {
          "const": "utf16-code-unit"
        }
      }
    },
    "module": {
      "type": "object",
      "required": [
        "path",
        "exports"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "exports": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "declarationName",
              "symbolIds"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/nonempty"
              },
              "declarationName": {
                "$ref": "#/$defs/nonempty"
              },
              "symbolIds": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/nonempty"
                }
              }
            }
          }
        }
      }
    },
    "symbol": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "classification",
        "signature",
        "source",
        "metadata"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonempty"
        },
        "name": {
          "$ref": "#/$defs/nonempty"
        },
        "kind": {
          "$ref": "#/$defs/nonempty"
        },
        "classification": {
          "enum": [
            "runtime",
            "type-only"
          ]
        },
        "signature": {
          "type": "string"
        },
        "parentId": {
          "$ref": "#/$defs/nonempty"
        },
        "source": {
          "type": "object",
          "required": [
            "path",
            "range",
            "rangeConvention"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/path"
            },
            "range": {
              "$ref": "#/$defs/range"
            },
            "rangeConvention": {
              "$ref": "#/$defs/convention"
            }
          }
        },
        "metadata": {
          "type": "object",
          "required": [
            "modulePath"
          ],
          "properties": {
            "modulePath": {
              "$ref": "#/$defs/path"
            },
            "typeExpressionRoot": {
              "const": true
            },
            "typeExpression": {
              "type": "object",
              "required": [
                "operator",
                "syntaxKind"
              ],
              "additionalProperties": false,
              "properties": {
                "operator": {
                  "enum": [
                    "object",
                    "union",
                    "intersection",
                    "opaque",
                    "application",
                    "array",
                    "type-operator"
                  ]
                },
                "syntaxKind": {
                  "type": "string",
                  "minLength": 1
                },
                "branchIndex": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 19999
                },
                "argumentIndex": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 19999
                },
                "targetName": {
                  "type": "string",
                  "minLength": 1
                },
                "typeOperator": {
                  "const": "readonly"
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "operator": {
                        "const": "application"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "targetName"
                    ]
                  },
                  "else": {
                    "not": {
                      "required": [
                        "targetName"
                      ]
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "operator": {
                        "const": "type-operator"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "typeOperator"
                    ]
                  },
                  "else": {
                    "not": {
                      "required": [
                        "typeOperator"
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "ts-type-literal",
                  "ts-union-type",
                  "ts-intersection-type",
                  "ts-type-expression",
                  "ts-type-application",
                  "ts-array-type",
                  "ts-type-operator"
                ]
              }
            }
          },
          "then": {
            "required": [
              "parentId",
              "exported"
            ],
            "properties": {
              "classification": {
                "const": "type-only"
              },
              "exported": {
                "const": false
              },
              "metadata": {
                "required": [
                  "typeExpression"
                ]
              }
            },
            "not": {
              "required": [
                "comment"
              ]
            }
          }
        }
      ]
    }
  }
}
