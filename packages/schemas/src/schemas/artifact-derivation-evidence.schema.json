{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mandolin.github.io/HIA-Documentation/schemas/artifact-derivation-evidence-0.1.0-draft.schema.json",
  "$comment": "中文：派生来源声明的结构定义，实际字节/链接/规则语义由独立核验负责。 English: Structural definition of derivation claims; independent verification owns actual bytes, links and rule semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "contractVersion",
    "id",
    "producer",
    "evidenceOrigin",
    "resources",
    "activities",
    "derivations",
    "coverage",
    "mapRefs",
    "details"
  ],
  "properties": {
    "contract": {
      "const": "artifact-derivation-evidence"
    },
    "contractVersion": {
      "const": "0.1.0-draft"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "producer": {
      "$ref": "#/$defs/identity"
    },
    "evidenceOrigin": {
      "enum": [
        "producer-recorded",
        "static-inferred"
      ]
    },
    "coverage": {
      "enum": [
        "resource",
        "value-links"
      ]
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "activities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/activity"
      }
    },
    "derivations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/derivation"
      }
    },
    "mapRefs": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/mapRef"
      }
    },
    "details": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 10000,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*[\\\\:%?#\\u0000-\\u001f])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[/]$).+$"
    },
    "ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "contractVersion"
      ],
      "properties": {
        "contract": {
          "$ref": "#/$defs/text"
        },
        "contractVersion": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "path",
        "sha256"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "source",
            "artifact"
          ]
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "profile",
        "inputs",
        "outputs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "$ref": "#/$defs/id"
        },
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "inputs": {
          "$ref": "#/$defs/ids"
        },
        "outputs": {
          "$ref": "#/$defs/ids"
        }
      }
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "activityId",
        "inputs",
        "outputs",
        "mapRefIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "activityId": {
          "$ref": "#/$defs/id"
        },
        "inputs": {
          "$ref": "#/$defs/ids"
        },
        "outputs": {
          "$ref": "#/$defs/ids"
        },
        "mapRefIds": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "mapRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "resourceId",
        "contract",
        "contractVersion"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "resourceId": {
          "$ref": "#/$defs/id"
        },
        "contract": {
          "$ref": "#/$defs/text"
        },
        "contractVersion": {
          "$ref": "#/$defs/text"
        }
      }
    }
  }
}
