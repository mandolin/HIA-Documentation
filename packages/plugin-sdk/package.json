{
  "name": "@hia-doc/plugin-sdk",
  "version": "1.0.0",
  "description": "Documentation producer contracts and runtime helpers for HIA adapters.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mandolin/HIA-Documentation.git",
    "directory": "packages/plugin-sdk"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./plain-data-initialization": {
      "types": "./dist/plain-data-initialization.d.ts",
      "import": "./dist/plain-data-initialization.js"
    },
    "./plain-data-initialization.schema.json": "./dist/plain-data-initialization.schema.json",
    "./derivation-evidence": {
      "types": "./dist/derivation-evidence.d.ts",
      "import": "./dist/derivation-evidence.js"
    },
    "./artifact-derivation-evidence.schema.json": "./dist/artifact-derivation-evidence.schema.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --root ../.. packages/plugin-sdk/src"
  },
  "dependencies": {
    "@hia-doc/core": "workspace:*"
  },
  "sideEffects": false
}
